{
  // The browser half's compile surface: it shares the model layer (`src/model`)
  // with the host half, swapping in the DOM library and the panel sources. The
  // bundle is assembled by tools/build-client.mjs; this file only type-checks.
  //
  // JSX uses the classic transform (`jsx: "react"`): every JSX site becomes a
  // `React.createElement` call, so the browser only needs the single `react`
  // entry on its module table, not the `react/jsx-runtime` subpath.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../model/**/*.ts", "../host/contract.ts", "../host/write.ts", "../host/gateway.ts", "../host/settings-fields.ts", "../host/project-config.ts"]
}