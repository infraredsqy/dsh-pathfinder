{
  // The model layer's compile face: pure logic, one tsconfig. Source here imports no runtime
  // dependencies, so type checking needs only the compiler itself (the host half's dependency
  // types stay out).
  // Check-only, no output: the model layer's types are gated by this one command; the build side
  // belongs to tsconfig.host.json.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts"]
}