{
  "name": "dsh-pathfinder",
  "version": "0.0.0",
  "private": true,
  "description": "把 agent-pathfinder 的管线搬进 DSH：宿主半身按当前会话的工作区读那份记录，交给浏览器半身",
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "types": "tsc -b tsconfig.host.json",
    "types:model": "tsc -p src/model/tsconfig.json",
    "test": "node --test tests/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}