{
  "name": "dsh-pathfinder",
  "version": "0.1.0-alpha.1",
  "description": "把 agent-pathfinder 的管线搬进 DSH：宿主半身按当前会话的工作区读那份记录，交给浏览器半身",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infraredsqy/dsh-pathfinder.git"
  },
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prepack": "npm run types && npm run bundle && npm run bundle:client",
    "bundle": "tsdown",
    "bundle:client": "node tools/build-client.mjs",
    "watch": "tsdown --watch",
    "types": "tsc -b tsconfig.host.json",
    "types:model": "tsc -p src/model/tsconfig.json",
    "types:client": "tsc -p src/client/tsconfig.json",
    "check:panel": "node tools/build-client.mjs && node tools/panel-check.mjs",
    "test": "node --test tests/"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.14",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}