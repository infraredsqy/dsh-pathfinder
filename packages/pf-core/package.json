{
  "name": "pf-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "pf handle and ledger library: frozen record types, the executor seam and the namespaced interface surface. Pure TypeScript, zero runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "pf-merge-ledger": "./dist/merge-ledger.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
