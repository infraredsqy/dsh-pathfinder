{
  // Host half compile config: src/host compiles to lib/types, then tsdown bundles it into lib/host/index.js.
  // DSH's own plugin packages follow this layout (source → lib/types → lib), so publish surface stays in step with source.
  // Record-shape types belong to the model layer (src/model/records.ts); the host contract re-exports them, hence its inclusion.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo"
  },
  "include": ["src/host/**/*.ts", "src/model/records.ts"]
}